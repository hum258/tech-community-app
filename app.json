{
  "expo": {
    "name": "Tech Community",
    "slug": "tech-community-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hum258.techcommunity"
    },
    "android": {
      "package": "com.hum258.techcommunity",
      "adaptiveIcon": {
        "backgroundColor": "#1D9BF0"
      },
      "navigationBarColor": "#FFFFFF",
      "navigationBarDividerColor": "#E6ECF0",
      "userInterfaceStyle": "light"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "techcommunity",
    "plugins": [
      "./plugins/withTechCommunitySplash"
    ]
  }
}
